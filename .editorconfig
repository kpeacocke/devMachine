# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 4 space indentation for most code
[*.{ps1,psm1,psd1,cs,java,c,cpp,h,hpp,go,rs}]
indent_style = space
indent_size = 4

# 2 space indentation for web/config files
[*.{json,yml,yaml,xml,html,css,scss,js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
end_of_line = lf

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 120

# Makefiles require tabs
[Makefile]
indent_style = tab

[*.{make,mk}]
indent_style = tab

# Python
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# Ruby
[*.rb]
indent_style = space
indent_size = 2

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf

# PowerShell
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4
end_of_line = crlf

# GitHub workflow files
[.github/workflows/*.{yml,yaml}]
indent_style = space
indent_size = 2

# Package manager files
[{package.json,*.yaml,*.yml}]
indent_style = space
indent_size = 2

# Git config files
[.git*]
indent_style = space
indent_size = 2
